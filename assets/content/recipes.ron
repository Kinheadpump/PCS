// Recipes. Integers only (D-014). Work time is in ticks at 100% work speed.
// workshop: the building (buildings.ron id) that makes the recipe.
// inputs and outputs: pairs of (material id, units).
[
    (id: "plank", name: "Make planks", workshop: "workshop", inputs: [("log", 1)], outputs: [("plank", 2)], work_ticks: 200),
    (id: "firewood", name: "Make firewood", workshop: "workshop", inputs: [("log", 1)], outputs: [("firewood", 2)], work_ticks: 100),
    // Cooking (Sprint 7). One run makes one meal, so "keep N" stops at exactly N.
    (id: "meal_barley", name: "Cook barley meal", workshop: "kitchen", inputs: [("barley", 2)], outputs: [("meal", 1)], work_ticks: 150),
    (id: "meal_turnips", name: "Cook turnip meal", workshop: "kitchen", inputs: [("turnips", 2)], outputs: [("meal", 1)], work_ticks: 150),
    (id: "meal_rye", name: "Cook rye meal", workshop: "kitchen", inputs: [("rye", 2)], outputs: [("meal", 1)], work_ticks: 150),
    (id: "meal_sorghum", name: "Cook sorghum meal", workshop: "kitchen", inputs: [("sorghum", 2)], outputs: [("meal", 1)], work_ticks: 150),
    (id: "meal_roots", name: "Cook root meal", workshop: "kitchen", inputs: [("wild_roots", 3)], outputs: [("meal", 1)], work_ticks: 150),
    // Tools and building blocks (Sprint 12). A stone tool needs a block and a log.
    (id: "stone_block", name: "Cut stone blocks", workshop: "workshop", inputs: [("granite", 2)], outputs: [("stone_block", 1)], work_ticks: 200),
    (id: "block_limestone", name: "Cut limestone blocks", workshop: "workshop", inputs: [("limestone", 2)], outputs: [("stone_block", 1)], work_ticks: 150),
    (id: "block_sandstone", name: "Cut sandstone blocks", workshop: "workshop", inputs: [("sandstone", 2)], outputs: [("stone_block", 1)], work_ticks: 150),
    (id: "block_slate", name: "Cut slate blocks", workshop: "workshop", inputs: [("slate", 2)], outputs: [("stone_block", 1)], work_ticks: 180),
    (id: "stone_axe", name: "Make stone axe", workshop: "forge", inputs: [("stone_block", 1), ("log", 1)], outputs: [("stone_axe", 1)], work_ticks: 250),
    (id: "stone_pick", name: "Make stone pick", workshop: "forge", inputs: [("stone_block", 1), ("log", 1)], outputs: [("stone_pick", 1)], work_ticks: 250),
    (id: "clothes", name: "Sew simple clothes", workshop: "workshop", inputs: [("fiber", 3)], outputs: [("simple_clothes", 1)], work_ticks: 250),
    // Chains that need knowledge from a lore fragment (R-042). `requires` is the knowledge key.
    (id: "charcoal", name: "Burn charcoal", workshop: "kiln", inputs: [("log", 2)], outputs: [("charcoal", 2)], work_ticks: 300, requires: Some("charcoal")),
    (id: "brick", name: "Fire bricks", workshop: "kiln", inputs: [("clay", 2), ("firewood", 1)], outputs: [("brick", 2)], work_ticks: 250, requires: Some("fired_clay")),
    (id: "smoked_barley", name: "Smoke barley", workshop: "kitchen", inputs: [("barley", 2), ("firewood", 1)], outputs: [("smoked_food", 2)], work_ticks: 200, requires: Some("smoked_food")),
    (id: "smoked_turnips", name: "Smoke turnips", workshop: "kitchen", inputs: [("turnips", 2), ("firewood", 1)], outputs: [("smoked_food", 2)], work_ticks: 200, requires: Some("smoked_food")),
    (id: "smoked_rye", name: "Smoke rye", workshop: "kitchen", inputs: [("rye", 2), ("firewood", 1)], outputs: [("smoked_food", 2)], work_ticks: 200, requires: Some("smoked_food")),
    (id: "smoked_sorghum", name: "Smoke sorghum", workshop: "kitchen", inputs: [("sorghum", 2), ("firewood", 1)], outputs: [("smoked_food", 2)], work_ticks: 200, requires: Some("smoked_food")),
    (id: "iron_bar", name: "Smelt iron", workshop: "smelter", inputs: [("iron_ore", 2), ("charcoal", 1)], outputs: [("iron", 1)], work_ticks: 400, requires: Some("smelting")),
    (id: "iron_axe", name: "Forge iron axe", workshop: "forge", inputs: [("iron", 2), ("plank", 1)], outputs: [("iron_axe", 1)], work_ticks: 400, requires: Some("iron_tools")),
    (id: "iron_pick", name: "Forge iron pick", workshop: "forge", inputs: [("iron", 2), ("plank", 1)], outputs: [("iron_pick", 1)], work_ticks: 400, requires: Some("iron_tools")),
]
