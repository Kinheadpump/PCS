// Races (R-048, R-049). Integers only (D-014). Races have no spells.
// A race changes these values of the colonist:
//   age_scale_pct: the days of one age year, as a percent of `days_per_age_year` in `family.ron`.
//   elder_age_delta: years added to `elder_age` in `family.ron`.
//   comfort_low_delta: tenths of a degree added to the lower limit of the comfort band.
//   migrant_weight: the weight of the race among migrants and among the people of rival
//     colonies. 0 means never.
// The first race is the race of the start colonists. A colonist of the same race follows the
// default rule: opinion 0, can be a partner, can have offspring, the child gets the race of the
// mother. Each pair of different races has one rule:
//   opinion: points that the pair adds to the opinion of the relation (a named part).
//   partner: false means that the two cannot become partners.
//   offspring: false means that the pair has no children.
//   child: the race of the child: "mother", "father", "either" (a hash of the parents), or the
//     key of a race.
(
    races: [
        (key: "folk", name: "Folk", age_scale_pct: 100, elder_age_delta: 0, comfort_low_delta: 0, migrant_weight: 60),
        // Short, stocky, and long-lived. They bear the cold.
        (key: "stonekin", name: "Stonekin", age_scale_pct: 160, elder_age_delta: 20, comfort_low_delta: -60, migrant_weight: 15),
        // Slender and short-lived. They feel the cold early.
        (key: "reedfolk", name: "Reedfolk", age_scale_pct: 70, elder_age_delta: -10, comfort_low_delta: 40, migrant_weight: 15),
        // Pale people of the burnt lands. They live a little longer than folk.
        (key: "ashborn", name: "Ashborn", age_scale_pct: 130, elder_age_delta: 10, comfort_low_delta: -20, migrant_weight: 10),
    ],
    pairs: [
        (a: "folk", b: "stonekin", opinion: -2, partner: true, offspring: true, child: "either"),
        (a: "folk", b: "reedfolk", opinion: 2, partner: true, offspring: true, child: "mother"),
        (a: "folk", b: "ashborn", opinion: -3, partner: true, offspring: false, child: "mother"),
        (a: "stonekin", b: "reedfolk", opinion: -6, partner: false, offspring: false, child: "mother"),
        (a: "stonekin", b: "ashborn", opinion: 0, partner: true, offspring: true, child: "ashborn"),
        (a: "reedfolk", b: "ashborn", opinion: 3, partner: true, offspring: false, child: "mother"),
    ],
)
