// Wild plants (R-007). Integers only (D-014).
// A wild plant stands on a tile when the tile ground is in the list, no tree or building is on
// the tile, and a tile hash is below density (per-mille of the tiles). The plant grows in colonies
// with an annual mean temperature from mean_min to mean_max (tenths of a degree). This is
// the biome rule: the preset climate selects the plants.
// yield_units: units that one gathering gives. regrow_days: game days until the plant is ripe
// again. The days do not count in winter.
// ground: letters S (soil), C (clay), D (sand).
[
    (id: "berry_bush", name: "Berry bush", product: "berries", ground: "SC", density: 14, mean_min: 50, mean_max: 350, yield_units: 4, regrow_days: 8),
    (id: "wild_root", name: "Wild root", product: "wild_roots", ground: "SCD", density: 10, mean_min: -150, mean_max: 350, yield_units: 3, regrow_days: 10),
    (id: "wild_flax", name: "Wild flax", product: "fiber", ground: "SCD", density: 8, mean_min: 0, mean_max: 350, yield_units: 2, regrow_days: 12),
]
